#!/bin/sh
set -eu
NORMAN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NORMAN_ARCH=$(uname -m)
case "$(uname -s)" in
    Darwin)
        if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" = "1" ]; then NORMAN_ARCH=arm64; fi
        case "$NORMAN_ARCH" in arm64|aarch64) NORMAN_TARGET=macos-arm64;; x86_64|amd64) NORMAN_TARGET=macos-x64;; *) echo "Unsupported CPU" >&2; exit 2;; esac;;
    Linux)
        case "$NORMAN_ARCH" in arm64|aarch64) NORMAN_TARGET=linux-arm64;; x86_64|amd64) NORMAN_TARGET=linux-x64;; *) echo "Unsupported CPU" >&2; exit 2;; esac;;
    *) echo "Use norman-fig2ppt.exe on Windows" >&2; exit 2;;
esac
NORMAN_EXECUTABLE="$NORMAN_ROOT/norman-fig2ppt-$NORMAN_TARGET"
if [ ! -x "$NORMAN_EXECUTABLE" ]; then chmod u+x "$NORMAN_EXECUTABLE"; fi
exec "$NORMAN_EXECUTABLE" "$@"
