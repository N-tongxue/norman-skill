#!/bin/sh
set -eu
TASK_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$(uname -s)" != "Darwin" ]; then
    echo 'On Windows use bin/windows-x64/norman-paper2ppt.exe' >&2; exit 2
fi
TASK_ARCH=$(uname -m)
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" = "1" ]; then TASK_ARCH=arm64; fi
case "$TASK_ARCH" in arm64|aarch64) TASK_ARCH=arm64;; x86_64) ;; *) echo 'Unsupported architecture' >&2; exit 2;; esac
TASK_PYTHON="$TASK_BIN_DIR/../vendor/norman-fig2ppt/bin/macos-$TASK_ARCH/runtime/bin/python3.12"
TASK_DEPS="$TASK_BIN_DIR/macos-$TASK_ARCH/site-packages"
TASK_APP="$TASK_BIN_DIR/macos-common/norman-paper2ppt.pyz"
if [ ! -f "$TASK_PYTHON" ] || [ ! -f "$TASK_APP" ]; then echo 'Incomplete package' >&2; exit 2; fi
if [ ! -x "$TASK_PYTHON" ]; then chmod u+x "$TASK_PYTHON"; fi
exec "$TASK_PYTHON" -I -B -c 'import sys,runpy;sys.path.insert(0,sys.argv.pop(1));p=sys.argv.pop(1);sys.argv[0]=p;runpy.run_path(p,run_name="__main__")' "$TASK_DEPS" "$TASK_APP" "$@"
