#!/bin/sh
set -eu
TASK_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "$(uname -s)" != "Darwin" ]; then
    printf '%s\n' 'On Windows use bin/windows-x64/norman-reader.exe.' >&2
    exit 2
fi
TASK_MACHINE=$(uname -m)
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || true)" = "1" ]; then
    TASK_MACHINE=arm64
fi
case "$TASK_MACHINE" in
    arm64|aarch64) TASK_ARCH=arm64 ;;
    x86_64) TASK_ARCH=x86_64 ;;
    *) printf '%s\n' 'Unsupported Mac architecture.' >&2; exit 2 ;;
esac
TASK_PYTHON="$TASK_BIN_DIR/macos-$TASK_ARCH/python3.12"
TASK_ENGINE="$TASK_BIN_DIR/macos-common/norman-reader.pyz"
TASK_HOME="$TASK_BIN_DIR/macos-common/python"
if [ ! -f "$TASK_PYTHON" ] || [ ! -f "$TASK_ENGINE" ] || [ ! -f "$TASK_HOME/lib/python312.zip" ]; then
    printf '%s\n' 'Incomplete package: keep the complete norman-paper-reading folder.' >&2
    exit 2
fi
# File transfers can lose executable bits. Repair only the bundled interpreter.
if [ ! -x "$TASK_PYTHON" ]; then
    chmod u+x "$TASK_PYTHON"
fi
unset PYTHONPATH PYTHONSTARTUP PYTHONINSPECT PYTHONUSERBASE
export PYTHONHOME="$TASK_HOME"
export PYTHONNOUSERSITE=1
exec "$TASK_PYTHON" -s -B "$TASK_ENGINE" "$@"
